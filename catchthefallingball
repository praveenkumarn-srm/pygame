from ursina import *
app=Ursina()

score = 0



ground=Entity(
    model="plane",
    color=color.green,
    scale=(15,15,15),
    y=-1.3
)

basket=Entity(
    model="cube",
    color=color.orange,
    scale=(2,0.5,1),
    y=-1,
    collider="box"
)

falling_ball=Entity(
    model="sphere",
    color=color.red,
    y=5,
    collider="box"
)

def update():
    global score
    if held_keys["a"]:
        basket.x-=5 * time.dt
    if held_keys["d"]:
        basket.x+=5 * time.dt
    falling_ball.y -= 4 * time.dt
     # Catch
    if basket.intersects(falling_ball).hit:
        score=score+1
        text.text=f"score : {score}"
        falling_ball.x=random.randint(-5,5)
        falling_ball.y=8

    if falling_ball.y<-2:
        falling_ball.x=random.randint(-5,5)
        falling_ball.y=8

text=Text(
    text="score:0",
    x=-0.89,
    y=0.5

)

EditorCamera()
app.run()
































